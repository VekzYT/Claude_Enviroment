{
  "name": "cubopolis",
  "version": "0.1.0",
  "private": true,
  "description": "Cubopolis - a voxel city builder for iPhone",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "sync": "npm run build && npx cap copy ios"
  },
  "dependencies": {
    "@capacitor/core": "7.6.10",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@capacitor/ios": "7.6.10",
    "@types/node": "22.19.1",
    "@types/three": "0.186.0",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
