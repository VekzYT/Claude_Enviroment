 "script": [
  {
   "beat": "cold open, demo 1 (small and selfish)",
   "text": "Monday. Your alarm won't shut up. Hit it. Mine.",
   "pause_after": 0.55
  },
  {
   "beat": "cold open, demo 2 (useful)",
   "text": "Missed the bus? Don't go around the school. Go through it. Mine. Mine.",
   "pause_after": 1.3
  },
  {
   "beat": "cold open, demo 3 (a little uncanny)",
   "text": "Someone parked on your bike. Mine.",
   "pause_after": 1.2
  },
  {
   "beat": "the command (title card)",
   "text": "What if you could mine anything?",
   "pause_after": 1.0
  },
  {
   "beat": "the rule",
   "text": "Keep hitting anything, and it breaks into a block. It flies into your inventory.",
   "pause_after": 0.5
  },
  {
   "beat": "that's real (science.md facts 1 and 2)",
   "text": "But a real block of stone weighs two point seven tonnes. A stack of sixty-four? A hundred and seventy-three tonnes. As heavy as a blue whale. That's real.",
   "pause_after": 0.6
  },
  {
   "beat": "the cost",
   "text": "And you feel nothing. So something, somewhere, is holding it for you.",
   "pause_after": 1.1
  },
  {
   "beat": "the Admin notices (red chat)",
   "text": "And it just noticed.",
   "pause_after": 0
  }
 ],
