# Godot's import cache -- regenerated on first open.
game/.godot/

# Release output: the zip and the audio preview are built by tools, not tracked.
game/build/

__pycache__/
*.pyc

# YouTube channel studio: dependencies, renders and secrets stay out of git.
channel/studio/node_modules/
channel/studio/out/
.env
.env.*

# Local voice models (Chatterbox, Kokoro): the virtualenv and generated audio stay out of git.
channel/voice/.venv/
channel/voice/out/
# Voice tracks are rebuilt from episode.json by channel/voice/voice_kokoro.py (Kokoro is deterministic).
channel/studio/public/**/*.wav
